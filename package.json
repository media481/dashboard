{
  "name": "dashboard-amiru",
  "version": "1.0.0",
  "description": "Dashboard Amiru — PWA manajemen program Umroh (vanilla JS + Supabase).",
  "private": true,
  "scripts": {
    "test": "node tests/test-core.js",
    "test:ci": "node tests/test-core.js",
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "release": "npm run build && npm run stamp",
    "check": "npm run build:check && npm run stamp:check",
    "stamp": "node scripts/stamp-versions.mjs",
    "stamp:check": "node scripts/stamp-versions.mjs --check",
    "test:ig": "node test-core.js",
    "test:edge": "node --experimental-strip-types supabase/functions/generate-ig-content-plan/test-core.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
