# Cloudflare Pages/Workers membaca file ini otomatis untuk menambah HTTP header
# ke semua response.
#
# CSP ini dibangun khusus untuk Dashboard Amiru (bukan Merdeka) — daftar
# domain di bawah diambil dari yang benar-benar dipakai index.html/js/app.js:
#   - cdn.jsdelivr.net      -> @supabase/supabase-js
#   - cdnjs.cloudflare.com  -> bootstrap-icons (css), jspdf, html2canvas
#   - fonts.googleapis.com / fonts.gstatic.com -> Google Fonts
#   - *.supabase.co         -> koneksi Supabase (REST + Edge Functions)
#
# Kalau nanti nambah CDN baru di index.html, jangan lupa tambahkan
# domainnya di script-src / style-src di bawah juga, atau kena blokir CSP
# persis seperti error yang barusan muncul.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co https://cdnjs.cloudflare.com https://api.open-meteo.com; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'

# Katalog publik: aset statis di-cache browser (revalidate di belakang layar)
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/favicon.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# --- Cache aset aplikasi ---
# css/ dan js/ dirujuk index.html dengan ?v=<hash isi file> (dibuat oleh
# scripts/stamp-versions.mjs), jadi aman di-cache setahun: file berubah -> URL berubah.
# WAJIB jalankan `npm run stamp` sebelum commit kalau mengubah file di css/ atau js/.
/js/*
  Cache-Control: public, max-age=31536000, immutable
/css/*
  Cache-Control: public, max-age=31536000, immutable
/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/logo-amirutour.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# Titik masuk: selalu dicek ulang ke server (murah: 304 bila tidak berubah), karena
# merekalah yang menunjuk ke versi css/js terbaru dan ke Service Worker terbaru.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/service-worker.js
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache
